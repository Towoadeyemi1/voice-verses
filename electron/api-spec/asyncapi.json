        },
        "data": {
         "type": "object",
         "properties": {
          "running": {
           "type": "integer"
          }
         },
         "required": [
          "running"
         ]
        }
       }
      }
     ]
    }
   },
   "alert_changed": {
    "name": "alert.changed",
    "title": "alert.changed",
    "summary": "Alerts on the screens changed.",
