{
 "asyncapi": "3.0.0",
 "info": {
  "title": "Voice Verses events",
  "version": "1.0.0",
  "x-app-version": "1.19.6",
  "description": "Events Voice Verses sends while it runs, as CloudEvents 1.0. Follow them at /api/v1/events (Server-Sent Events or WebSocket, with ?types=live.* to choose), or have them POSTed to a webhook. A change that would break a reader gets a new type (….v2) beside the old one. Events made while the operator practises are never sent."
 },
 "servers": {
  "booth": {
   "host": "{host}:{port}",
   "protocol": "ws",
   "pathname": "/api/v1/events",
   "variables": {
    "host": {
     "default": "voice-verses.local"
    },
    "port": {
     "default": "47100"
    }
   },
   "security": [
    {
     "$ref": "#/components/securitySchemes/key"
    }
   ]
  }
 },
 "channels": {
  "events": {
   "address": "/api/v1/events",
   "messages": {
    "live_changed": {
     "$ref": "#/components/messages/live_changed"
    },
    "next_changed": {
     "$ref": "#/components/messages/next_changed"
    },
    "countdown_changed": {
     "$ref": "#/components/messages/countdown_changed"
    },
    "alert_changed": {
     "$ref": "#/components/messages/alert_changed"
    },
    "listening_started": {
     "$ref": "#/components/messages/listening_started"
    },
    "listening_stopped": {
     "$ref": "#/components/messages/listening_stopped"
    },
    "speech_heard": {
     "$ref": "#/components/messages/speech_heard"
    },
    "verse_found": {
     "$ref": "#/components/messages/verse_found"
    },
    "suggestion_offered": {
     "$ref": "#/components/messages/suggestion_offered"
    },
    "service_updated": {
     "$ref": "#/components/messages/service_updated"
    },
    "service_deleted": {
     "$ref": "#/components/messages/service_deleted"
    },
    "media_updated": {
     "$ref": "#/components/messages/media_updated"
    },
    "media_deleted": {
     "$ref": "#/components/messages/media_deleted"
    },
    "bible_changed": {
     "$ref": "#/components/messages/bible_changed"
    },
    "module_registered": {
     "$ref": "#/components/messages/module_registered"
    },
    "package_received": {
     "$ref": "#/components/messages/package_received"
    }
   }
  }
 },
