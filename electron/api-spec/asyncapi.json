        },
        "data": {
         "type": "object",
         "properties": {
          "count": {
           "type": "integer"
          },
          "text": {
           "type": "string"
          }
         },
         "required": [
          "count"
         ]
        }
       }
      }
     ]
    }
   },
   "listening_started": {
    "name": "listening.started",
    "title": "listening.started",
    "summary": "Listening started.",
