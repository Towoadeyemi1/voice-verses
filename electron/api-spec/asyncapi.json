 "components": {
  "securitySchemes": {
   "key": {
    "type": "httpBearerToken",
    "description": "The key received when pairing (or ?key=)"
   }
  },
  "schemas": {
   "CloudEvent": {
    "type": "object",
    "required": [
     "specversion",
     "id",
     "source",
     "type",
     "time",
     "data"
    ],
    "properties": {
     "specversion": {
      "const": "1.0"
     },
     "id": {
      "type": "string"
     },
     "source": {
      "type": "string",
      "examples": [
       "voiceverses://app/live"
      ]
     },
     "type": {
      "type": "string"
     },
     "name": {
      "type": "string",
      "description": "The short name, e.g. live.changed"
     },
     "time": {
      "type": "string",
      "format": "date-time"
     },
     "datacontenttype": {
      "const": "application/json"
     },
     "data": {
      "type": "object"
     }
    }
   }
  },
  "messages": {
   "live_changed": {
    "name": "live.changed",
    "title": "live.changed",
    "summary": "What the screens show changed: a verse, a slide, the logo, or nothing.",
    "contentType": "application/cloudevents+json",
    "payload": {
     "allOf": [
      {
       "$ref": "#/components/schemas/CloudEvent"
      },
      {
       "type": "object",
       "properties": {
        "type": {
         "const": "org.voiceverses.live.changed.v1"
        },
        "name": {
         "const": "live.changed"
        },
        "data": {
         "type": "object",
         "properties": {
          "kind": {
           "enum": [
            "verse",
            "slide",
            "logo",
            "clear"
           ]
          },
          "reference": {
           "type": "string"
          },
          "translation": {
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "verse": {
           "type": "object",
           "properties": {
            "book": {
             "type": "string"
            },
            "chapter": {
             "type": "integer"
            },
            "verse": {
             "type": "integer"
            },
            "text": {
             "type": "string"
            }
           }
          },
          "slide": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string"
            },
            "type": {
             "type": "string"
            },
            "title": {
             "type": "string"
            },
            "songTitle": {
             "type": "string"
            },
            "sectionLabel": {
             "type": "string"
            },
            "content": {
             "type": "string"
            }
           }
          }
         },
         "required": [
          "kind"
         ]
        }
       }
      }
     ]
    }
   },
   "next_changed": {
    "name": "next.changed",
    "title": "next.changed",
    "summary": "What waits in Next changed.",
    "contentType": "application/cloudevents+json",
    "payload": {
     "allOf": [
      {
       "$ref": "#/components/schemas/CloudEvent"
      },
      {
       "type": "object",
       "properties": {
        "type": {
         "const": "org.voiceverses.next.changed.v1"
        },
        "name": {
         "const": "next.changed"
        },
        "data": {
         "type": "object",
         "properties": {
          "kind": {
           "enum": [
            "verse",
            "slide",
            "none"
           ]
          },
          "reference": {
           "type": "string"
          },
          "title": {
           "type": "string"
          }
         },
         "required": [
          "kind"
         ]
        }
       }
      }
     ]
    }
   },
   "countdown_changed": {
    "name": "countdown.changed",
    "title": "countdown.changed",
    "summary": "Countdowns on the screens changed.",
