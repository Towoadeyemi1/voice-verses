            "screens",
            "next"
           ]
          }
         },
         "required": [
          "reference",
          "went"
         ]
        }
       }
      }
     ]
    }
   },
   "suggestion_offered": {
    "name": "suggestion.offered",
    "title": "suggestion.offered",
