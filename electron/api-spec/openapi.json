          "live": {
           "description": "The data of the last live.changed event",
           "type": [
            "object",
            "null"
           ]
          },
          "next": {
           "description": "The data of the last next.changed event",
           "type": [
            "object",
            "null"
           ]
          },
          "updatedAt": {
           "type": [
            "string",
