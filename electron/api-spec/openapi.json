      ]
     }
    }
   },
   "Shown": {
    "type": "object",
    "properties": {
     "kind": {
      "enum": [
       "verse",
       "slide",
       "logo",
       "none"
      ]
     },
     "reference": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    }
   },
   "Device": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "scopes": {
      "type": "array",
      "items": {
       "enum": [
        "read",
        "control",
        "write"
       ]
      }
     },
     "createdAt": {
      "type": "string",
      "format": "date-time"
     },
     "lastUsed": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "webhooks": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Webhook"
      }
     }
    }
   },
   "Webhook": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "types": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "createdAt": {
      "type": "string",
      "format": "date-time"
     },
     "failures": {
      "type": "integer"
     },
     "paused": {
      "type": "boolean"
     }
    }
   },
   "Module": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "answers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "emits": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "listens": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "Service": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "type": {
      "type": [
       "string",
       "null"
      ]
     },
     "parts": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "items": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
