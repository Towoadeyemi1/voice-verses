{
 "openapi": "3.1.0",
 "info": {
  "title": "Voice Verses local API",
  "version": "1.0.0",
  "x-app-version": "1.19.4",
  "description": "Control Voice Verses and follow what it does from other apps and devices on the church network. Turn it on in Voice Verses: Settings → Other apps and devices. The address is shown there (port 47100 unless changed), and Voice Verses announces itself with Bonjour as _voiceverses._tcp.\n\nPair once: Voice Verses shows a six-digit code; POST it to /pair and keep the key you receive. Send the key as `Authorization: Bearer <key>` on every request (event streams also accept `?key=`, for browsers' EventSource and WebSocket). Each key is allowed some of: read, control, write.\n\nLive events are described in asyncapi.json.",
  "license": {
   "name": "See the Voice Verses repository"
  }
 },
 "servers": [
  {
   "url": "http://{host}:{port}/api/v1",
   "variables": {
    "host": {
     "default": "voice-verses.local"
    },
    "port": {
     "default": "47100"
    }
   }
  }
 ],
 "tags": [
  {
   "name": "About"
  },
  {
   "name": "Pairing"
  },
  {
   "name": "Live"
  },
  {
   "name": "Services"
  },
  {
   "name": "Events"
  },
  {
   "name": "Webhooks"
  }
 ],
 "paths": {
  "/": {
   "get": {
    "summary": "What this is",
    "tags": [
     "About"
    ],
    "security": [],
    "responses": {
     "200": {
      "description": "Voice Verses and its API version.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "name": {
           "type": "string"
          },
          "version": {
           "type": "string"
          },
          "api": {
           "type": "string",
           "const": "1"
          },
          "pairing": {
           "type": "boolean",
           "description": "A pairing code is showing now"
          },
          "docs": {
           "type": "object"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/pair": {
   "post": {
    "summary": "Pair this device with the code Voice Verses shows",
    "tags": [
     "Pairing"
    ],
    "security": [],
    "description": "The code works once, for five minutes, and five wrong tries use it up. At most five tries a minute from one address.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "code"
        ],
        "properties": {
         "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
         },
         "name": {
          "type": "string",
          "maxLength": 60,
          "description": "What Voice Verses calls this device, e.g. \"Stream Deck in the booth\""
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Paired. Keep the key: it is shown only now.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "key": {
           "type": "string"
          },
          "device": {
           "$ref": "#/components/schemas/Device"
          }
         }
        }
       }
      }
     },
     "403": {
      "description": "No code is showing, the code is wrong, or it was used up.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Too many tries.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/me": {
   "get": {
    "summary": "This device, and what it may do",
    "tags": [
     "Pairing"
    ],
    "security": [
     {
      "key": []
     }
    ],
    "responses": {
     "200": {
      "description": "This device.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Device"
        }
       }
      }
     },
     "401": {
      "description": "Not paired: no key, or a removed key.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "This device isn't allowed to do this.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/modules": {
   "get": {
    "summary": "The modules in this Voice Verses: what each answers, sends and listens for",
    "tags": [
     "About"
    ],
    "security": [
     {
      "key": [
       "read"
      ]
     }
    ],
    "responses": {
     "200": {
