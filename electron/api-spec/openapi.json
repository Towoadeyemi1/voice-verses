        }
       }
      }
     },
     "403": {
      "description": "This device isn't allowed to do this.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "The reference wasn't found.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Not possible now: the live screen isn't open, nothing is in Next, or Voice Verses is in practice.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "504": {
      "description": "Voice Verses didn't answer.",
      "content": {
       "application/json": {
