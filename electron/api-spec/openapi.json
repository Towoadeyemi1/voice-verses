  "/events": {
   "get": {
    "summary": "Follow events as they happen (Server-Sent Events, or upgrade to a WebSocket)",
    "tags": [
     "Events"
    ],
    "security": [
     {
      "key": [
       "read"
      ]
     },
     {
      "keyQuery": [
       "read"
      ]
     }
    ],
    "description": "Each event is a CloudEvents 1.0 envelope (see asyncapi.json). As Server-Sent Events, each has `event:` set to its name. A WebSocket on the same address sends each as a text message.",
    "parameters": [
     {
      "name": "types",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "description": "Comma-separated names or patterns, e.g. live.*,speech.heard (default: everything)"
     }
    ],
    "responses": {
     "200": {
      "description": "An event stream.",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "401": {
      "description": "Not paired: no key, or a removed key.",
      "content": {
