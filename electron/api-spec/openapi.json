     },
     "403": {
      "description": "This device isn't allowed to do this.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/webhooks": {
   "get": {
    "summary": "This device's webhooks",
    "tags": [
     "Webhooks"
    ],
    "security": [
     {
      "key": [
       "read"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "Webhooks.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "webhooks": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Webhook"
           }
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Not paired: no key, or a removed key.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "This device isn't allowed to do this.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Send events to an address as they happen",
    "tags": [
     "Webhooks"
    ],
    "security": [
     {
      "key": [
       "read"
      ]
     }
    ],
    "description": "Each event is POSTed as application/cloudevents+json, signed: X-VoiceVerses-Signature is sha256=<hex HMAC-SHA256 of the body with the secret>. Three tries per event, in order. After 20 failed events in a row the webhook is paused (shown in Settings). At most 10 per device.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "url"
        ],
        "properties": {
         "url": {
          "type": "string",
          "format": "uri"
         },
         "types": {
          "type": "array",
          "items": {
           "type": "string"
          },
          "default": [
           "*"
          ]
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Created. Keep the secret: it is shown only now.",
      "content": {
       "application/json": {
        "schema": {
         "allOf": [
          {
           "$ref": "#/components/schemas/Webhook"
          },
          {
           "type": "object",
           "properties": {
            "secret": {
             "type": "string"
            }
           }
          }
         ]
        }
       }
      }
     },
     "400": {
      "description": "Not a usable address.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "Not paired: no key, or a removed key.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "This device isn't allowed to do this.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/webhooks/{id}": {
   "delete": {
    "summary": "Stop a webhook",
    "tags": [
     "Webhooks"
    ],
    "security": [
     {
      "key": [
       "read"
      ]
     }
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Stopped."
     },
     "404": {
      "description": "No such webhook for this device.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "Not paired: no key, or a removed key.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "This device isn't allowed to do this.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "key": {
    "type": "http",
    "scheme": "bearer",
    "description": "The key received when pairing"
   },
   "keyQuery": {
    "type": "apiKey",
    "in": "query",
    "name": "key",
    "description": "Event streams only"
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
