       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "live": {
           "$ref": "#/components/schemas/Shown"
          },
          "next": {
           "$ref": "#/components/schemas/Shown"
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Not paired: no key, or a removed key.",
